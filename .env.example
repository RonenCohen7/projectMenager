# docker compose settings - copy to .env and fill in

APP_PORT=80
FRONTEND_URL=http://your-server-address

MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=project_manager
MYSQL_USER=pm_user
MYSQL_PASSWORD=change_me

# Long random string (openssl rand -hex 32)
JWT_SECRET=change_me_to_a_long_random_string

# First admin - created on start, logs in with a code sent to this email
ADMIN_EMAIL=admin@example.com
ADMIN_FIRST_NAME=Admin

# SMTP for login codes (required in production)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM=Project Manager <noreply@your-domain.com>
