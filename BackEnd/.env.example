# development / production
ENVIRONMENT=development
PORT=4321

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=pm_user
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=project_manager

# Long random string (openssl rand -hex 32)
JWT_SECRET=change_me_to_a_long_random_string

FRONTEND_URL=http://localhost:5291

# First admin - created on start if missing
ADMIN_EMAIL=admin@example.com
ADMIN_FIRST_NAME=Admin

# SMTP for login codes (empty in development = the code is printed to the console)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
